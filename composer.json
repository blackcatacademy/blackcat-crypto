{
    "name": "blackcat/crypto",
    "description": "Centralized cryptography services for BlackCat platform (AEAD, HMAC, KMS wrapping, rotations)",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "bin": [
        "bin/crypto"
    ],
    "autoload": {
        "psr-4": {
            "BlackCat\\Crypto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackCat\\Crypto\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
