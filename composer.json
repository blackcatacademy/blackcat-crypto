{
    "name": "blackcat/crypto",
    "description": "Centralized cryptography services for the BlackCat ecosystem (AEAD, HMAC, KMS wrapping, key rotations)",
    "keywords": [
        "blackcat",
        "cryptography",
        "security",
        "encryption",
        "aead",
        "xchacha20-poly1305",
        "hmac",
        "kms",
        "key-rotation",
        "libsodium"
    ],
    "homepage": "https://github.com/blackcatacademy/blackcat-crypto",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "bin": [
        "bin/crypto"
    ],
    "autoload": {
        "psr-4": {
            "BlackCat\\Crypto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackCat\\Crypto\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
